{
	"expression: condition - normal form": {
		"prefix": ["condn"],
		"body": [
			"(cond",
			"\t((${1:predication}) ${2:branch})",
			"\t((${3:predication}) ${4:branch}))"
		],
		"description": "condition normal form expression"
	},
	"expression: condition - else form": {
		"prefix": ["conde"],
		"body": [
			"(cond",
			"\t((${1:predication}) ${2:branch})",
			"\t(else ${3:default-branch}))"
		],
		"description": "condition else form expression"
	},
	"expression: lambda": {
		"prefix": ["lam"],
		"body": [
			"(lambda (${1:formal-parameters}) ${2:body})"
		],
		"description": "lambda expression"
	},
	"expression: let": {
		"prefix": ["let"],
		"body": [
			"(let ((${1:var} ${2:exp})$3)",
			"${4:body})"
		],
		"description": "let expression"
	},
	"function environment: single line": {
		"prefix": ["defs"],
		"body": [
			"(define (${1:function-name} ${2:parameters}) ${3:function-body})"
		],
		"description": "single-line function environment"
	},
	"function environment: multi-line": {
		"prefix": ["defm"],
		"body": [
			"(define (${1:function-name} ${2:parameters})",
			"\t${3:function-body})"
		],
		"description": "multi-line function environment"
	},
	"function environment: lambda": {
		"prefix": ["defl"],
		"body": [
			"(lambda (${1:formal-parameters}) ${2:body})"
		],
		"description": "lambda function environment"
	},
	"function definition: square": {
		"prefix": ["square"],
		"body": [
			"(define (square x) (* x x))"
		],
		"description": "square function definition"
	},
	"function definition: identity": {
		"prefix": ["iden"],
		"body": [
			"(define (identity x) x)"
		],
		"description": "identity function definition"
	}
}

