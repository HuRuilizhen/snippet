{
	"expression: condition - normal form": {
		"prefix": ["condn"],
		"body": [
			"(cond",
			"\t((${1:predication}) ${2:branch})",
			"\t((${3:predication}) ${4:branch}))"
		],
		"description": "condition normal form expression"
	},
	"expression: condition - else form": {
		"prefix": ["conde"],
		"body": [
			"(cond",
			"\t((${1:predication}) ${2:branch})",
			"\t(else ${3:default-branch}))"
		],
		"description": "condition else form expression"
	},
	"expression: lambda": {
		"prefix": ["lam"],
		"body": [
			"(lambda (${1:formal-parameters}) ${2:body})"
		],
		"description": "lambda expression"
	},
	"expression: let": {
		"prefix": ["let"],
		"body": [
			"(let ((${1:var} ${2:exp})$3)",
			"${4:body})"
		],
		"description": "let expression"
	},
	"function environment: single line": {
		"prefix": ["defs"],
		"body": [
			"(define (${1:function-name} ${2:parameters}) ${3:function-body})"
		],
		"description": "single-line function environment"
	},
	"function environment: multi-line": {
		"prefix": ["defm"],
		"body": [
			"(define (${1:function-name} ${2:parameters})",
			"\t${3:function-body})"
		],
		"description": "multi-line function environment"
	},
	"function environment: lambda": {
		"prefix": ["defl"],
		"body": [
			"(lambda (${1:formal-parameters}) ${2:body})"
		],
		"description": "lambda function environment"
	},
	"function definition: square": {
		"prefix": ["square"],
		"body": [
			"(define (square x) (* x x))"
		],
		"description": "square function definition"
	},
	"function definition: identity": {
		"prefix": ["iden"],
		"body": [
			"(define (identity x) x)"
		],
		"description": "identity function definition"
	},
	"function definition: accumulate": {
		"prefix": ["acc", "accumulate"],
		"body": [
			"(define (accumulate op initial sequence)",
			"\t(if (null? sequence) initial",
    	"\t\t(op (car sequence) (accumulate op initial (cdr sequence)))))"
		],
		"description": "accumulate function definition"
	},
	"function definition: filter": {
		"prefix": ["filter"],
		"body": [
			"(define (filter predicate sequence)",
			"\t(cond",
    	"\t\t((null? sequence) nil)",
    	"\t\t((predicate (car sequence))",
      "\t\t\t(cons (car sequence) (filter predicate (cdr sequence))))",
      "\t\t(else (filter predicate (cdr sequence)))))"
		],
		"description": "filter function definition"
	},
	"function definition: flatmap": {
		"prefix": ["fmap", "flatmap"],
		"body": [
			"(define (flatmap proc seq)",
			"\t(accumulate append '() (map proc seq)))"
		],
		"description": "flatmap function definition"
	},
	"function definition: enumerate-interval": {
		"prefix": ["enumi", "enumerate-interval"],
		"body": [
			"(define (enumerate-interval low high)",
  		"\t(if (> low high) '()",
    	"\t\t(cons low (enumerate-interval (+ low 1) high))))"
		],
		"description": "interval enumeration function definition"
	},
	"primitive: nil": {
		"prefix": ["nil"],
		"body": [
			"'()"
		],
		"description": "nil primitive"
	}
}

