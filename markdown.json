{
	"table of content": {
		"prefix": ["tocs"],
		"body": [
			"## Table of Content",
			"",
			"<!--toc:start-->",
			"",
			"<!--toc:end-->"
		],
		"description": "table of contents markers"
	},
	"text block of tree structure": {
		"prefix": ["tree"],
		"body": [
			"```text",
			"${1:root}",
			"├── ${2:node}",
			"│   └── ${3:node}",
			"└── ${4:node}",
			"```"
    ],
    "description": "text block of tree structure"
	},
	"pass status emoji": {
		"prefix": ["epass"],
		"body": ["✅"],
		"description": "emoji of pass status"
	},
	"cancel status emoji": {
		"prefix": ["ecancel"],
		"body": ["❌"],
		"description": "emoji of cancel status"
	},
	"delete status emoji": {
		"prefix": ["edelete"],
		"body": ["🗑️"],
		"description": "emoji of delete status"
	}
}
